(rocq.extraction
 (prelude Extract)
 (extracted_files solver.ml solver.mli)
 (theories Stdlib Equations RocqSAT))

(executable
 (name runner)
 (public_name rocqsat)
 (libraries rocq-runtime.kernel)
 ; Inline more aggressively, e.g. the literal comparison into the loops of the solver.
 (ocamlopt_flags (:standard -inline 200))
 (modules solver store_rt runner)
 ; The C solver of ../c, called with --c.
 (foreign_stubs
  (language c)
  (names solver main c_stub)
  (flags :standard -O2)))

(copy_files# ../c/*.{c,h})
