; The proofs that the C solver of ../../solver computes the solver step of ../core, over CompCert's semantics of
; Clight (library RocqSAT.refinement.c).
(rocq.theory
 (name RocqSAT.refinement.c)
 (package rocqsat)
 (theories Stdlib Flocq MenhirLib compcert Equations RocqSAT RocqSAT.refinement)
 (flags :standard -w -deprecated-from-Coq,-abstract-large-number))

; The Clight of the solver, generated by CompCert's clightgen.
(rule
 (targets solver.v)
 (deps ../../solver/solver.c ../../solver/solver.h)
 (action
  (run clightgen -normalize ../../solver/solver.c -o solver.v)))
